  <link name="ur_gripper_mount_link"/>
  <ros2_control name="RobotiqGripperHardwareInterface" type="system">
    <!-- Plugins -->
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- Joint interfaces -->
    <!-- With Ignition or Hardware, they handle mimic joints, so we only need this command interface activated -->
    <joint name="ur_robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.7929</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="ur_robotiq_85_right_knuckle_joint">
      <param name="mimic">ur_robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
    </joint>
    <joint name="ur_robotiq_85_left_inner_knuckle_joint">
      <param name="mimic">ur_robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">1</param>
    </joint>
    <joint name="ur_robotiq_85_right_inner_knuckle_joint">
      <param name="mimic">ur_robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
    </joint>
    <joint name="ur_robotiq_85_left_finger_tip_joint">
      <param name="mimic">ur_robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">-1</param>
    </joint>
    <joint name="ur_robotiq_85_right_finger_tip_joint">
      <param name="mimic">ur_robotiq_85_left_knuckle_joint</param>
      <param name="multiplier">1</param>
    </joint>
  </ros2_control>
